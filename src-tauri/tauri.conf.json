{
  "$schema": "https://raw.githubusercontent.com/nicedoc/jsonschema/master/src/schema/tauri.conf.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Xryloth",
    "version": "5.9.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": true,
        "sidecar": true,
        "open": true
      },
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true,
        "removeFile": true,
        "removeDir": true,
        "renameFile": true,
        "copyFile": true,
        "exists": true,
        "scope": ["**"]
      },
      "path": {
        "all": true
      },
      "window": {
        "all": true,
        "setTitle": true,
        "close": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "center": true,
        "startDragging": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true,
        "message": true
      },
      "protocol": {
        "asset": true,
        "assetScope": ["**"]
      },
      "clipboard": {
        "all": true,
        "readText": true,
        "writeText": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["nsis", "dmg", "appimage", "deb"],
      "identifier": "com.xryloth.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ],
      "resources": [],
      "windows": {
        "nsis": {
          "installMode": "currentUser",
          "headerImage": null,
          "sidebarImage": null,
          "template": null,
          "displayLanguageSelector": false
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Xryloth",
        "width": 1020,
        "height": 640,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "skipTaskbar": false
      }
    ]
  }
}
