{
    "$schema": "https://raw.githubusercontent.com/nicedoc/jsonschema/master/src/schema/tauri.conf.json",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "",
        "devPath": "http://localhost:1420",
        "distDir": "../dist",
        "withGlobalTauri": true
    },
    "package": {
        "productName": "Xryloth",
        "version": "6.0.0"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "shell": {
                "all": false,
                "execute": true,
                "sidecar": true,
                "open": true
            },
            "fs": {
                "all": true,
                "readFile": true,
                "writeFile": true,
                "readDir": true,
                "createDir": true,
                "removeFile": true,
                "removeDir": true,
                "renameFile": true,
                "copyFile": true,
                "exists": true,
                "scope": [
                    "**"
                ]
            },
            "path": {
                "all": true
            },
            "window": {
                "all": true,
                "setTitle": true,
                "close": true,
                "minimize": true,
                "maximize": true,
                "unmaximize": true,
                "center": true,
                "startDragging": true
            },
            "dialog": {
                "all": true,
                "open": true,
                "save": true,
                "message": true
            },
            "protocol": {
                "asset": true,
                "assetScope": [
                    "**"
                ]
            },
            "clipboard": {
                "all": true,
                "readText": true,
                "writeText": true
            }
        },
        "bundle": {
            "active": true,
            "targets": [
                "nsis",
                "dmg",
                "appimage",
                "deb"
            ],
            "identifier": "com.xryloth.app",
            "icon": [
                "icons/128x128@2x.png",
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/icon.ico"
            ],
            "resources": [
    "resources/mods/*"
  ],
            "windows": {
                "nsis": {
                    "installMode": "currentUser",
                    "headerImage": null,
                    "sidebarImage": null,
                    "template": null,
                    "displayLanguageSelector": false
                }
            },
            "deb": {
                "depends": [
                    "libwebkit2gtk-4.1-0",
                    "libjavascriptcoregtk-4.1-0",
                    "libgtk-3-0",
                    "libgdk-pixbuf-2.0-0",
                    "libglib2.0-0",
                    "libatk1.0-0",
                    "libcairo2",
                    "libpango-1.0-0",
                    "libgdk-pixbuf-2.0-0",
                    "libgstreamer1.0-0",
                    "gstreamer1.0-plugins-base",
                    "gstreamer1.0-plugins-good",
                    "libfuse2",
                    "libglib2.0-0",
                    "libgdk-3-0",
                    "libatk1.0-0",
                    "libcairo2",
                    "libpango-1.0-0",
                    "libgdk-pixbuf-2.0-0",
                    "libglib2.0-0"
                ]
            }
        },
        "security": {
            "csp": null
        },
        "windows": [
            {
                "title": "Xryloth",
                "width": 1020,
                "height": 640,
                "minWidth": 800,
                "minHeight": 500,
                "resizable": true,
                "decorations": false,
                "transparent": true,
                "center": true,
                "skipTaskbar": false,
                "visible": true,
                "focus": true
            }
        ]
    }
}