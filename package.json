{
  "name": "xryloth-tauri",
  "private": true,
  "version": "6.0.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:x64": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:x86": "tauri build --target i686-pc-windows-msvc",
    "tauri:build:all": "npm run tauri:build:x64 && npm run tauri:build:x86",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:macos": "tauri build --target x86_64-apple-darwin",
    "build:bat": "build.bat",
    "build:ps1": "powershell -ExecutionPolicy Bypass -File build.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.6.0",
    "firebase": "^12.16.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
